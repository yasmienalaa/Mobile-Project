<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp"
    android:background="@color/sage_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hey, Keep Going!"
            android:textColor="@color/sage_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/roleToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_unselected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:text="Student mode"
            android:textColor="#275346"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/screenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:id="@+id/navHome"
            style="@style/BottomNavItem.Selected"
            android:text="⌂  Home" />
        <TextView
            android:id="@+id/navEnrolled"
            style="@style/BottomNavItem"
            android:text="▤  Enrolled Courses" />
        <TextView
            android:id="@+id/navProfile"
            style="@style/BottomNavItem"
            android:text="♙  Profile" />
    </LinearLayout>
</LinearLayout>