<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">
        <EditText android:id="@+id/courseTitleInput" style="@style/CourseFormField" android:hint="Course title" android:inputType="textCapSentences" />
        <EditText android:id="@+id/courseLanguageInput" style="@style/CourseFormField" android:hint="Programming language (Kotlin, Java…)" android:inputType="textCapWords" />
        <EditText android:id="@+id/courseLevelInput" style="@style/CourseFormField" android:hint="Level (Beginner / Intermediate / Advanced)" android:inputType="textCapWords" />
        <EditText
            android:id="@+id/courseDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_input"
            android:gravity="top"
            android:hint="What will students learn?"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/editLessonsButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_filter_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Edit Lessons"
            android:textColor="#275346"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/lessonSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">
            <TextView
                android:id="@+id/lessonRequirementLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lessons (required)"
                android:textColor="#275346"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/addLessonButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_filter_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="＋   Add Lessons"
                android:textColor="#275346"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/noLessonsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Add at least one lesson before saving this course."
                android:textColor="@color/sage_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
