<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lesson Title"
            android:textColor="#275346"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/lessonTitleInput"
            style="@style/CourseFormField"
            android:hint="Enter lesson title"
            android:inputType="textCapSentences"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Content Type"
            android:textColor="#275346"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <Spinner
            android:id="@+id/lessonContentType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_input" />

        <EditText
            android:id="@+id/lessonTextContent"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_soft_input"
            android:gravity="top"
            android:hint="Write the lesson content here..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:textSize="15sp"/>

        <EditText
            android:id="@+id/lessonVideoUrl"
            style="@style/CourseFormField"
            android:layout_marginTop="16dp"
            android:hint="Paste video URL"
            android:inputType="textUri"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>