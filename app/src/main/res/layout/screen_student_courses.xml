<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/screenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="18dp" android:text="Home" android:textColor="#275346" android:textSize="29sp" android:textStyle="bold" />
        <TextView android:id="@+id/screenSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="18dp" android:text="Small steps. Lasting discoveries." android:textColor="@color/sage_primary" android:textSize="14sp" />
        <EditText android:id="@+id/courseSearch" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_soft_input" android:hint="Search courses or languages" android:inputType="text" android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="@color/sage_text" android:textColorHint="@color/sage_primary" android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="Programming language" android:textColor="@color/sage_text" android:textSize="12sp" android:textStyle="bold" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/languageFilters" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Course level" android:textColor="@color/sage_text" android:textSize="12sp" android:textStyle="bold" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/levelFilters" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/courseList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

