<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sage_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:id="@+id/lessonBackButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="‹  Back to course"
            android:textColor="#275346"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:textColor="#275346"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lessonType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_filter_unselected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="#275346"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/lessonContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_soft_card"
            android:padding="18dp"
            android:textColor="@color/sage_text"
            android:textSize="16sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/lessonVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_accent_panel"
            android:padding="14dp"
            android:textColor="#275346"
            android:textSize="14sp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/lessonEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_soft_card"
            android:padding="18dp"
            android:text="Lesson details will appear here once they are added."
            android:textColor="@color/sage_primary"
            android:textSize="14sp"
            android:visibility="gone" />
        <CheckBox
            android:id="@+id/lessonCompletedCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:buttonTint="#275346"
            android:text="Mark this lesson as completed"
            android:textColor="#275346"
            android:textSize="15sp"
            android:enabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previousLessonButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Previous"
                android:enabled="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/nextLessonButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next"
                android:enabled="false" />

        </LinearLayout>


    </LinearLayout>
</ScrollView>