<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/sage_primary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="BottomNavItem.Selected" parent="BottomNavItem">
        <item name="android:textColor">#275346</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CourseFormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_soft_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>